{
  "NvidiaNim": {
    "ApiKey": "",
    "BaseUrl": "https://integrate.api.nvidia.com/v1",
    "Proxy": "",
    "MaxTokens": 4096,
    "Temperature": 1.0,
    "TopP": 1.0,
    "TopK": -1,
    "MinP": 0.0,
    "RepetitionPenalty": 1.0,
    "PresencePenalty": 0.0,
    "FrequencyPenalty": 0.0,
    "MinTokens": 0,
    "Seed": null,
    "Stop": "",
    "ParallelToolCalls": true,
    "IgnoreEos": false
  },
  "Authentication": {
    "AuthToken": ""
  },
  "ModelRouting": {
    "Default": "nvidia/nemotron-3-ultra-550b-a55b",
    "Opus": "nvidia/nemotron-3-ultra-550b-a55b",
    "Sonnet": "nvidia/nemotron-3-super-120b-a12b",
    "Haiku": "deepseek-ai/deepseek-v4.1-flash",
    "EnableThinking": true,
    "EnableOpusThinking": null,
    "EnableSonnetThinking": null,
    "EnableHaikuThinking": null
  },
  "ModelCatalog": {
    "CacheMinutes": 30,
    "DefaultContextWindow": 131072,
    "DefaultMaxOutputTokens": 65536,
    "AdvertiseClaudeAliases": true
  },
  "RateLimits": {
    "RequestsPerWindow": 100,
    "WindowSeconds": 60,
    "MaxConcurrency": 5
  },
  "Timeouts": {
    "ReadSeconds": 120,
    "ConnectSeconds": 10,
    "StreamIdleSeconds": 120,
    "CompletionSeconds": 600
  },
  "Optimizations": {
    "MockQuotaProbe": true,
    "SkipTitleGeneration": true,
    "SkipSuggestionMode": true,
    "DetectCommandPrefix": true,
    "MockFilePathExtraction": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ClaudeNim": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  }
}
